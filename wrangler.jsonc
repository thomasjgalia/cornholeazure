{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cornhole",
	"compatibility_date": "2026-08-27",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "soldelco",
			"database_id": "0b83ed0c-9d10-4292-8edc-45da52c7b069"
		}
	],
	"routes": [{ "pattern": "cornhole.soldelco.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
